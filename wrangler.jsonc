{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "state-machine-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  // No public URL: the API is reached only through the editor's /api/* (service binding)
  "workers_dev": false,
  "preview_urls": false,
  // No database_id: `wrangler deploy` creates the D1 database the first time
  "d1_databases": [{ "binding": "DB", "database_name": "state-machines" }],
  "vars": {
    // Comma separated origins allowed to call the API from a browser.
    // Production needs none (same origin); this is for `npm run dev` of the editor.
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  // Branch builds run `wrangler preview`, which wants its own vars
  "previews": {
    "vars": { "ALLOWED_ORIGINS": "http://localhost:5173" }
  }
}
